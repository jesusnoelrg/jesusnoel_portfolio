---
const { name, description, solution } = Astro.props;
import { ArrowRight, ArrowDown } from '@lucide/astro';
---

<div class="flex flex-col md:flex-row items-stretch justify-center gap-4 my-5">
  <div 
    class="
      flex flex-col items-start justify-start 
      w-full md:w-4/9
      stretch
      gap-2 p-6
      border border-zinc-300 dark:border-amber-800/30 rounded-2xl 
      shadow-md shadow-amber-800/10 dark:shadow-amber-800/30
      bg-amber-300/10 dark:bg-amber-900/10
      text-amber-800 dark:text-amber-200
      hover:bg-amber-300/20 dark:hover:bg-amber-900/20
      hover:shadow-amber-800/30 dark:hover:shadow-amber-800/60
      transition-all duration-300
    ">
    <h1 class="text-md lg:text-lg xl:text-xl font-bold">{name}</h1>
    <p class="text-[12px] sm:text-[14px] lg:text-[16px] xl:text-lg">{description}</p>
  </div>
  <ArrowRight class="hidden md:block h-12 w-1/9 text-zinc-500 dark:text-zinc-400 self-center" />
  <ArrowDown class="block md:hidden h-12 w-full text-zinc-500 dark:text-zinc-400 self-center" />
  <div 
    class="
      flex flex-col items-start justify-start 
      w-full md:w-4/9
      stretch
      gap-2 p-6
      border border-zinc-300 dark:border-green-800/30 rounded-2xl
      shadow-md shadow-green-800/10 dark:shadow-green-800/30
      bg-lime-300/10 dark:bg-lime-900/10
      text-green-800 dark:text-green-200
      hover:bg-green-800/20 dark:hover:bg-green-900/20
      hover:shadow-green-800/30 dark:hover:shadow-green-800/60
      transition-all duration-300
    ">
    <h1 class="text-md lg:text-xl xl:text-xl font-bold">Solución</h1>
    <p class="text-[12px] sm:text-[14px] lg:text-[16px] xl:text-lg">{solution}</p>
  </div>
</div>