--- 
const { name, icon, description } = Astro.props;
import IconDynamic from './IconDynamic.astro';
---

<div 
  class="
    flex flex-col items-start justify-start 
    gap-2 p-6
    border border-zinc-300 dark:border-zinc-900 rounded-2xl
     bg-(--bg-card) dark:bg-(--bg-card-dark)
     text-black dark:text-white
     hover:bg-zinc-100 dark:hover:bg-zinc-900
     transition-all duration-300
    ">
    <div class="flex flex-col items-start justify-start gap-2">
        <IconDynamic name={icon} className="w-12 h-12 bg-zinc-200 dark:bg-zinc-800 rounded-full p-2 text-zinc-800 dark:text-zinc-200" />
        <h1 class="text-md lg:text-md xl:text-lg font-bold">{name}</h1>
    </div>
    <p class="text-sm lg:text-sm xl:text-base text-zinc-700 dark:text-zinc-300">{description}</p>
  </div>