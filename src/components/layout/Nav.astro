---
import { Sun, Moon, House, UserPen, Folder, MailOpen } from '@lucide/astro';
import Logo from '@assets/logo.svg';

const currentLocation = Astro.url.pathname;
const isHome = currentLocation === "/";
---

<script>
  const setupThemeToggle = () => {
    const btnTheme = document.querySelector("#theme-toggle");
    if (!btnTheme) return;

    btnTheme.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.theme = isDark ? "dark" : "light";

      btnTheme.classList.add("theme-toggle");
      setTimeout(() => {
        btnTheme.classList.remove("theme-toggle");
      }, 500);
    });
  };

  const setupNavScroll = () => {
    const header = document.querySelector("#site-header");
    if (!header) return;

    const update = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 48);
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
  };

  setupThemeToggle();
  setupNavScroll();
</script>

<style>
  .site-header {
    transition:
      padding 0.35s ease,
      margin 0.35s ease;
  }

  .site-header.is-home {
    padding-top: 1rem;
    padding-inline: 1.25rem;
  }

  .site-header.is-home.is-scrolled {
    padding-top: 0.625rem;
    padding-inline: 2.5rem;
  }

  @media (min-width: 768px) {
    .site-header.is-home {
      padding-inline: 4rem;
    }

    .site-header.is-home.is-scrolled {
      padding-inline: 7rem;
    }
  }

  @media (min-width: 1024px) {
    .site-header.is-home {
      padding-inline: 8rem;
    }

    .site-header.is-home.is-scrolled {
      padding-inline: 12rem;
    }
  }

  @media (min-width: 1280px) {
    .site-header.is-home.is-scrolled {
      padding-inline: 16rem;
    }
  }

  .site-header:not(.is-home) {
    margin-inline: 1.25rem;
    padding-block: 1.25rem;
  }

  .site-header:not(.is-home).is-scrolled {
    margin-inline: 2.5rem;
    padding-block: 0.75rem;
  }

  @media (min-width: 768px) {
    .site-header:not(.is-home) {
      margin-inline: 5rem;
    }

    .site-header:not(.is-home).is-scrolled {
      margin-inline: 7rem;
    }
  }

  @media (min-width: 1024px) {
    .site-header:not(.is-home) {
      margin-inline: 10rem;
    }

    .site-header:not(.is-home).is-scrolled {
      margin-inline: 14rem;
    }
  }

  .site-nav {
    transition: padding 0.35s ease;
  }

  .site-header.is-scrolled .site-nav {
    padding-block: 0.25rem;
  }

  .site-logo {
    transition: width 0.35s ease, height 0.35s ease;
  }

  .site-header.is-scrolled .site-logo {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (min-width: 640px) {
    .site-logo {
      width: 2.5rem;
      height: 2.5rem;
    }

    .site-header.is-scrolled .site-logo {
      width: 2rem;
      height: 2rem;
    }
  }

  .nav-link-mobile {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .nav-link {
    display: flex;
    position: relative;
    align-items: center;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 10px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: purple;
    transition: width 0.3s ease-in-out;
  }

  .nav-link:hover::after{
    width: 100%;
  }

  .theme-toggle {
    animation: rotate 0.8s ease-in-out;
  }


  @keyframes rotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>

<div id="home"></div>
<header 
  id="site-header"
  class:list={[
    "site-header left-0 right-0 z-100 text-black dark:text-white",
    isHome ? "is-home fixed top-0" : "sticky top-0"
  ]}>
  <nav class:list={[
    "site-nav flex justify-between align-items-center rounded-2xl border backdrop-blur-md",
    isHome
      ? "border-white/15 dark:border-white/10 bg-white/50 dark:bg-black/25"
      : "border-zinc-300 dark:border-zinc-600 bg-zinc-50/70 dark:bg-zinc-950/40"
  ]}>
    <a class="flex items-center mx-4" href="/">
      <Logo class="site-logo w-5 h-5 sm:w-10 sm:h-10 text-black dark:text-white" />
    </a>
    <ul class="hidden sm:flex gap-8 align-items-center">
      <li class="nav-link"><a href={currentLocation === "/" ? "#home" : "/#home"}>Inicio</a></li>
      <li class="nav-link"><a href={currentLocation === "/" ? "#about" : "/#about"}>Sobre mí</a></li>
      <li class="nav-link"><a href={currentLocation === "/" ? "#projects" : "/#projects"}>Proyectos</a></li>
      <li class="nav-link"><a href={currentLocation === "/" ? "#contact" : "/#contact"}>Contacto</a></li>
    </ul>
    <div class="p-1 sm:p-3">
      <button id="theme-toggle" class="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-900">
        <Sun class="w-5 h-5 text-gray-500 dark:hidden" />
        <Moon class="w-5 h-5 text-gray-500 hidden dark:block" />
      </button>
    </div>
  </nav>
</header>
<div class="fixed w-full bottom-0 z-50 border border-zinc-300 dark:border-zinc-600 backdrop-blur-sm dark:bg-zinc-950/30 bg-zinc-50/30 rounded-t-2xl">
  <ul class="flex sm:hidden justify-around align-items-center p-4 pointer-events-auto text-black dark:text-white text-[10px]">
    <li class="nav-link-mobile hover:text-purple-400/50 transition-colors duration-300">
      <a class="flex flex-col justify-center items-center" href={currentLocation === "/" ? "#home" : "/#home"}>
        <House class="w-5 h-5" /> 
        Inicio</a>
    </li>
    <li class="nav-link-mobile hover:text-purple-400/50 transition-colors duration-300">
      <a class="flex flex-col justify-center items-center" href={currentLocation === "/" ? "#about" : "/#about"}>
        <UserPen class="w-5 h-5" /> 
        Sobre mí</a>
    </li>
    <li class="nav-link-mobile hover:text-purple-400/50 transition-colors duration-300">
      <a class="flex flex-col justify-center items-center" href={currentLocation === "/" ? "#projects" : "/#projects"}>
        <Folder class="w-5 h-5" /> 
        Proyectos</a>
    </li>
    <li class="nav-link-mobile hover:text-purple-400/50 transition-colors duration-300">
      <a class="flex flex-col justify-center items-center" href={currentLocation === "/" ? "#contact" : "/#contact"}>
        <MailOpen class="w-5 h-5" /> 
        Contacto</a>
    </li>
  </ul>
</div>