---
import TextShimmer from '@components/effects/TextShimmer.astro';
import Badge from '@components/ui/Badge.astro';
import projects from '../../data/projects.json';
import technologies from '../../data/technologies.json';
import ProjectsList from '@components/ui/ProjectsList.tsx';
import { resolveAsset } from '../../utils/resolveAsset';
import { ArrowRight } from 'lucide-react';

const proyectos = projects.map(project => (
  {
    slug: project.slug,
    title: project.title,
    image: resolveAsset(project.assets.present),
    description: project.content.description,
    techStack: project.tech_stack,
  }
));
---

<section class="relative flex items-center justify-center py-20 md:py-24 mb-10">
  <div id="projects" class="absolute -top-24"></div>
  <div class="flex flex-col items-center justify-center container z-10">
    <TextShimmer 
      text="MI EXPERIENCIA" 
      color1="#391d43" color2="#7d6187" color3="#391d43" 
      class="text-md md:text-xl font-bold" 
    />
    <p class="text-3xl md:text-5xl font-bold text-zinc-800 dark:text-zinc-300 mb-10">Proyectos</p>
    <ProjectsList client:load />
  </div>
</section>