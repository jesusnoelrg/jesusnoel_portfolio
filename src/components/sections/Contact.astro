---
import TextShimmer from "@components/effects/TextShimmer.astro";
import ContactForm from "@components/ui/ContactForm.tsx"

import GitHub from "@assets/icons/github.svg";
import LinkedIn from "@assets/icons/linkedin.svg";
import { Mail } from "@lucide/astro";

import social from '../../data/social.json' with { type: "json" };

const networks = [
  {
    plataform: "GitHub", icon: GitHub, ref: social.github
  },
  {
    plataform: "LinkedIn", icon: LinkedIn, ref: social.linkedin
  },
  {
    plataform: "Correo", icon: Mail, ref: `mailto:${social.email}`
  },
]
---

<section id="contact" class="contact-section relative overflow-hidden flex justify-center items-center w-full mt-25 text-black dark:text-white">
  <div class="flex flex-col lg:flex-row justify-evenly items-center container pt-10 pb-10">
    <div class="text-center lg:text-start lg:w-1/2 px-10 pt-10">
      <TextShimmer text="CONTACTO" color1="#391d43" color2="#7d6187" color3="#391d43"
        class="text-xl md:text-2xl font-bold" 
      />
      <h1 class="mb-5 text-3xl md:text-5xl font-bold">Listo para hablar</h1>
      <p class="leading-relaxed text-zinc-600 dark:text-zinc-300">
        Mi bandeja de entrada siempre está abierta puede contactarme por este medio o en las redes sociales 
        que dejo aquí abajo. No dude en contactarme y le responderé.
      </p>
      <div class="flex justify-center lg:justify-start items-center mt-10 gap-5">
        {
          networks.map(({plataform, icon: Icon, ref}) => (
            <a href={ref} target="_blank" 
              class="
              flex flex-col items-center justify-center
              space-y-2 px-4 py-2
              dark:text-white
              hover:scale-115 dark:hover:text-zinc-400/90
              cursor-pointer
              transition duration-300
              ">
              <Icon class="w-8 h-8 invert dark:invert-0" />
              <span class="text-sm text-black dark:text-white" >{plataform}</span>
            </a>
          ))
        }
      </div>
    </div>
    <ContactForm client:load />
  </div>
</section>

<style>
  .contact-section {
    background-color: #fafafa;
    border-top: 1px solid #e4e4e7;
  }

  :global(html.dark) .contact-section {
    background-color: #0e0e0e;
    border-top: 1px solid #1a1a1a;
  }
</style>