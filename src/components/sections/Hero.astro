---
import SoftAurora from '@components/effects/SoftAurora.tsx';
import TextShimmer from '@components/effects/TextShimmer.astro';

import Github from '@assets/icons/github.svg';
import LinkedIn from '@assets/icons/linkedin.svg';
import { Mail, FileDown } from '@lucide/astro';

import social from '../../data/social.json' with { type: "json" };

const networks = [
  {
    plataform: "GitHub", icon: Github, ref: social.github, invert: true
  },
  {
    plataform: "LinkedIn", icon: LinkedIn, ref: social.linkedin, invert: true
  },
  {
    plataform: "Correo", icon: Mail, ref: `mailto:${social.email}`, invert: false
  },
  {
    plataform: "CV", icon: FileDown, ref: social.cv, invert: false
  },
]
---
<section class="relative overflow-hidden flex flex-col justify-center items-center min-h-screen pt-28 pb-20 md:pt-32 md:pb-28 z-10 text-black dark:text-white">
  <SoftAurora
      client:idle

      speed={0.6}
      scale={1.2}
      brightness={0.85}
      color1="#391d43"
      color2="#340481"
      noiseFrequency={2.5}
      noiseAmplitude={2}
      bandHeight={0.35}
      bandSpread={1.4}
      octaveDecay={0.1}
      layerOffset={0}
      colorSpeed={1}
      enableMouseInteraction
      mouseInfluence={0}
   />

  <div class="flex flex-col items-center justify-center container relative z-10">
    <div class="text-center gap-5">
      <p class="text-xl md:text-2xl lg:text-3xl text-black dark:text-white">¡Hola, soy Jesús Noel!</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-medium text-pretty leading-none text-black dark:text-white">
        Desarrollador de 
        <TextShimmer text="Software" color1="#391d43" color2="#7d6187" color3="#391d43" class="font-bold" />
      </h1>
      <p class="px-10 md:px-15 lg:px-35 xl:px-50 text-md md:text-2xl text-shadow-lg text-center leading-relaxed text-balance text-gray-800 dark:text-gray-300">
        Ingeniero de Software <span class="text-purple-400">enfocado</span> en arquitectura de sistemas, optimización 
        de bases de datos y aplicaciones de alto rendimiento.
      </p>
    </div>
    <nav aria-label="redes-sociales" class="mt-10">
      <ul class="flex gap-8">
        {networks.map(({plataform, icon: Icon, ref, invert}) => (
          <li class="h-10 md:w-25">
            <a href={ref} aria-label={`Enlace a ${plataform}`} target="_blank" rel="noopener noreferrer"
              class="
                flex flex-col items-center justify-center p-3
                border border-zinc-300 dark:border-zinc-800 rounded-xl
                bg-zinc-100 dark:bg-zinc-950
                transition-all duration-200
                hover:scale-105 hover:bg-zinc-200 dark:hover:bg-zinc-900
                text-black dark:text-white"
            >
              <Icon aria-label={`Icono de ${plataform}`} role="img" class={`w-8 h-8 ${invert ? 'invert dark:invert-0' : ''}`} />
              <span class="mt-2 text-sm hidden md:block md:text-base text-black dark:text-white" >{plataform}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>